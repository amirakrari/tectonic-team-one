# Copy to .env and fill in. .env is gitignored.

# Base URL of the API. Keep the trailing slash.
# Placeholder: replace with the real API URL once it is deployed.
API_BASE_URL=https://api.example.com/

# true  = canned data from MockApiClient (no API needed)
# false = real calls to API_BASE_URL through ApiClient
API_USE_MOCK=true

# Host port the webapp is published on.
WEB_PORT=8080
