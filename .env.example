# Copy to .env at the repository root.
# Hosted Mailpit uses HTTPS send API; leave empty to use the SMTP settings below.
Email__MailpitUrl=https://mailpit.openislamu.org
Email__Host=localhost
Email__Port=1025
Email__EnableSsl=false
Email__From=expense-watch@example.test
Email__Recipient=presenter@example.test
# Optional authenticated relay credentials belong only in ignored .env.
# Email__Username=
# Email__Password=

# Generate the signing key outside this file: openssl rand -base64 32
# Jwt__SigningKey=
# WebAppOrigin=http://localhost:3000

# Inject a disposable Identity-compliant password to enable the simulator.
# Missing simulator credentials stop only the worker, not the API.
# Simulator__Password=
# Simulator__Enabled=false
# Simulator__BaseUrl=http://127.0.0.1:5000
# Simulator__IntervalSeconds=3

# Webapp configuration for the root docker-compose.yml.

# Base URL of the API. Keep the trailing slash.
# Placeholder: replace with the real API URL once it is deployed.
API_BASE_URL=https://api.example.com/

# true  = canned data from MockApiClient (no API needed)
# false = real calls to API_BASE_URL through ApiClient
API_USE_MOCK=true

# Host port the webapp is published on.
WEB_PORT=8080
