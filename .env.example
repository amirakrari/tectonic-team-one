# Copy to ignored .env. Paste the same settings into both Coolify applications.
# Defaults below target the hosted hackathon demo and containers on port 8080.
# Self-hosting: replace API_BASE_URL with your own API's HTTPS address.
# Full Coolify setup: docs/COOLIFY DEPLOYMENT GUIDE.md
# For native local runs, use the overrides in docs/OPERATIONS.md#local-startup.
# Labels below show which application consumes each setting.
# You can paste the whole file into both; unused settings are ignored.
# No secret is required by BOTH applications:
# - API ONLY: AUTHENTICATION_LOCAL_JWT_KEY is required.
# - API ONLY: EMAIL_USERNAME / EMAIL_PASSWORD are optional SMTP credentials.
# - API ONLY: SIMULATOR_PASSWORD is required for enabled single-account simulation.
#   SIMULATOR_ALL_USERS=true does not require a simulator password.
# - BLAZOR ONLY: SAMPLE_ACCOUNT_PASSWORD is optional for development demo login.
#   For simulator demo login, set it to the API's SIMULATOR_PASSWORD.
# Blazor receives JWTs from API login; it does not need the JWT signing key.

# BOTH API AND BLAZOR: runtime settings (not secrets).
# Both containers listen on 8080; expose that port in Coolify.
ASPNETCORE_HTTP_PORTS=8080
ASPNETCORE_ENVIRONMENT=Production
DOTNET_HOSTBUILDER__RELOADCONFIGONCHANGE=false
# COMPOSE ONLY: webapp host port; not a Coolify application setting or secret.
WEB_PORT=8080

# BLAZOR ONLY: API connection settings (not secrets).
# Blazor calls the deployed API through its public URL. Keep the trailing /.
# For native local runs: API_BASE_URL=http://127.0.0.1:5000/
# Do not use localhost here for two separate containers.
API_BASE_URL=https://tectonicapi.openislamu.org/
# false uses real authenticated API persistence; true uses canned webapp data.
API_USE_MOCK=false
# API ONLY: optional browser CORS origin (not a secret).
# Not needed for Blazor Server's server-side API calls.
WEB_APP_ORIGIN=

# API ONLY: required signing secret. Generate once: openssl rand -base64 32
# Keep the actual value only in ignored .env or Coolify.
AUTHENTICATION_LOCAL_JWT_KEY=
# API ONLY: JWT issuer and audience (not secrets).
AUTHENTICATION_LOCAL_JWT_ISSUER=expense-watch
AUTHENTICATION_LOCAL_JWT_AUDIENCE=expense-watch-web

# API ONLY: SQLite connection string (not a secret).
# Coolify: mount writable persistent storage at /data on the API.
# Local runs: override with Data Source=tectonic.db.
DATABASE_CONNECTION_STRING=Data Source=/data/tectonic.db

# API ONLY: email delivery. Choose Mailpit HTTP (default) OR SMTP.
# Mailpit HTTP: a nonempty URL selects HTTP and ignores all SMTP-only settings.
# View received alerts at https://mailpit.openislamu.org.
# To use your own Mailpit, replace this URL with its reachable HTTP(S) address.
EMAIL_MAILPIT_URL=https://mailpit.openislamu.org
# BOTH EMAIL TRANSPORTS: sender and recipient addresses.
# SMTP: replace these demo addresses with your provider-approved sender and inbox.
# Alerts go to EMAIL_RECIPIENT, not to the account's signup address.
EMAIL_FROM=expense-watch@example.test
EMAIL_RECIPIENT=presenter@example.test

# SMTP ONLY: clear EMAIL_MAILPIT_URL above to activate these settings.
# Set EMAIL_HOST to your provider's SMTP hostname, e.g. smtp.example.com.
# 587 with true uses STARTTLS; use your provider's supported STARTTLS settings.
# Implicit TLS/SMTPS on port 465 is not supported by the current SMTP client.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_ENABLE_SSL=true
# Set both to your provider's SMTP credentials if authentication is required.
# Keep credentials in ignored .env or Coolify runtime secrets, never this example.
# Leave both empty for Mailpit HTTP or an explicitly unauthenticated SMTP relay.
EMAIL_USERNAME=
EMAIL_PASSWORD=
# Local Mailpit SMTP: empty EMAIL_MAILPIT_URL, reachable EMAIL_HOST,
# EMAIL_PORT=1025, EMAIL_ENABLE_SSL=false, and empty SMTP credentials.
# Optional API runtime workaround ONLY if Mailpit IPv6 times out but IPv4 works.
# This does not disable HTTPS certificate validation.
# DOTNET_SYSTEM_NET_DISABLEIPV6=1

# API ONLY: automatic transaction generation for the live hackathon experience.
# Both flags must be true for new users to see automatic persisted transactions.
# Authentication can work even when simulation is disabled or stopped.
SIMULATOR_ENABLED=true
# true includes new AND existing accounts, each with its own history and clock.
# No SIMULATOR_PASSWORD is required in all-user mode.
# Do not manually post/advance dates while the simulator owns those clocks.
# Set SIMULATOR_ENABLED=false for a controlled manual demonstration.
SIMULATOR_ALL_USERS=true
# INTERNAL API endpoint: the worker runs inside the API container itself.
# This is HTTP loopback on container port 8080, NOT the public API domain.
# For native local API runs on port 5000: http://127.0.0.1:5000
SIMULATOR_BASE_URL=http://127.0.0.1:8080
# One simulated day per account every 3 seconds, plus request processing time.
SIMULATOR_INTERVAL_SECONDS=3
# Emails fire only for alert conditions, not for every transaction or login.
# From January 1, the first scheduled telecom alerts occur on February 5
# (roughly two minutes at this interval, plus request processing time).
# Save the API environment and redeploy an image with all-user simulation support.
#
# Optional SINGLE-ACCOUNT mode: set SIMULATOR_ALL_USERS=false and supply a stable
# Identity-compliant SIMULATOR_PASSWORD. Generate once: openssl rand -hex 16
# Append Aa1_ to satisfy the password policy; keep it across restarts.
# The email/password below are unused in all-user mode.
SIMULATOR_EMAIL=simulator@example.test
SIMULATOR_PASSWORD=
SIMULATOR_RENEW_BEFORE_EXPIRY_SECONDS=60

# BLAZOR ONLY: optional development demo login; disabled in Production.
# SAMPLE_ACCOUNT_PASSWORD is the secret; other values are not secrets.
# To log in as the simulator, match the API's SIMULATOR_EMAIL and SIMULATOR_PASSWORD.
SIMULATOR_DEMO_LOGIN_ENABLED=false
SAMPLE_ACCOUNT_NAME=Simulator
SAMPLE_ACCOUNT_EMAIL=simulator@example.test
SAMPLE_ACCOUNT_PASSWORD=
