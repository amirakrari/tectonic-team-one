# Copy to ignored .env. Paste the same settings into both Coolify applications.
# Labels below show which application consumes each setting.
# You can paste the whole file into both; unused settings are ignored.
# No secret is required by BOTH applications:
# - API ONLY: AUTHENTICATION_LOCAL_JWT_KEY is required.
# - API ONLY: EMAIL_USERNAME / EMAIL_PASSWORD are optional SMTP credentials.
# - API ONLY: SIMULATOR_PASSWORD is required for enabled single-account simulation.
#   SIMULATOR_ALL_USERS=true does not require a simulator password.
# - BLAZOR ONLY: SAMPLE_ACCOUNT_PASSWORD is optional for development demo login.
#   For simulator demo login, set it to the API's SIMULATOR_PASSWORD.
# Blazor receives JWTs from API login; it does not need the JWT signing key.

# BOTH API AND BLAZOR: runtime settings (not secrets).
# Both containers listen on 8080; expose that port in Coolify.
ASPNETCORE_HTTP_PORTS=8080
ASPNETCORE_ENVIRONMENT=Production
DOTNET_HOSTBUILDER__RELOADCONFIGONCHANGE=false
# COMPOSE ONLY: webapp host port; not a Coolify application setting or secret.
WEB_PORT=8080

# BLAZOR ONLY: API connection settings (not secrets).
# Replace with the API's URL reachable from the Blazor container, ending in /.
# Loopback below is for local development, not two separate containers.
API_BASE_URL=http://127.0.0.1:5000/
API_USE_MOCK=false
# API ONLY: optional browser CORS origin (not a secret).
# Not needed for Blazor Server's server-side API calls.
WEB_APP_ORIGIN=

# API ONLY: required signing secret. Generate once: openssl rand -base64 32
# Keep the actual value only in ignored .env or Coolify.
AUTHENTICATION_LOCAL_JWT_KEY=
# API ONLY: JWT issuer and audience (not secrets).
AUTHENTICATION_LOCAL_JWT_ISSUER=expense-watch
AUTHENTICATION_LOCAL_JWT_AUDIENCE=expense-watch-web

# API ONLY: SQLite connection string (not a secret).
# Coolify: mount writable persistent storage at /data on the API.
# Local runs: override with Data Source=tectonic.db.
DATABASE_CONNECTION_STRING=Data Source=/data/tectonic.db

# API ONLY: email delivery settings (not secrets).
# Hosted Mailpit demo inbox; a nonempty URL selects HTTP instead of SMTP.
EMAIL_MAILPIT_URL=https://mailpit.openislamu.org
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_ENABLE_SSL=false
EMAIL_FROM=expense-watch@example.test
EMAIL_RECIPIENT=presenter@example.test
# API ONLY: optional SMTP credentials; leave empty for Mailpit HTTP.
EMAIL_USERNAME=
EMAIL_PASSWORD=

# API ONLY: simulator settings; SIMULATOR_PASSWORD is the secret.
# Enable only after generating a stable password: openssl rand -hex 16
# Append Aa1_ to satisfy Identity's password policy.
SIMULATOR_ENABLED=false
# API ONLY: opt-in real persisted simulation for every account, including new signups.
# Keep false for controlled manual demos. Each user's own clock advances automatically.
SIMULATOR_ALL_USERS=false
SIMULATOR_BASE_URL=http://127.0.0.1:8080
SIMULATOR_INTERVAL_SECONDS=3
SIMULATOR_EMAIL=simulator@example.test
SIMULATOR_PASSWORD=
SIMULATOR_RENEW_BEFORE_EXPIRY_SECONDS=60

# BLAZOR ONLY: optional development demo login; disabled in Production.
# SAMPLE_ACCOUNT_PASSWORD is the secret; other values are not secrets.
# To log in as the simulator, match the API's SIMULATOR_EMAIL and SIMULATOR_PASSWORD.
SIMULATOR_DEMO_LOGIN_ENABLED=false
SAMPLE_ACCOUNT_NAME=Simulator
SAMPLE_ACCOUNT_EMAIL=simulator@example.test
SAMPLE_ACCOUNT_PASSWORD=
