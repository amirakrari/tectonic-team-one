@inherits LayoutComponentBase
@implements IDisposable
@inject UiState Ui
@inject IJSRuntime JS
@inject Loc L
@inject AccountStore Accounts
@inject NavigationManager Nav
@inject ProtectedSessionStorage Session

<MudThemeProvider Theme="Theme" IsDarkMode="Ui.DarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (Ui.SignedIn)
{
<div class="@ShellClass" style="--kbc-accent: @Ui.Accent; --kbc-page-bg: @(Ui.ActiveTheme?.Gradient ?? "none")">
    <aside class="rail">
        <NavMenu Language="Ui.Language" />
    </aside>

    <div class="main">
        <header class="topbar">
            <button type="button" class="back-btn" aria-label="@L["common.back"]" @onclick="GoBackAsync">
                <KbcIcon Name="arrow-left" Size="18" />
            </button>
            <span class="topbar-title"><SectionOutlet SectionName="page-title" /></span>
            <span class="topbar-spacer"></span>
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <ActivatorContent>
                    <button type="button" class="user-chip" aria-label="@L["common.accountMenu"]" @onclick="context.ToggleAsync">
                        <span class="avatar" aria-hidden="true"></span>
                        <span class="user-name">@Ui.UserName</span>
                        <KbcIcon Name="chevron-down" Size="18" />
                    </button>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Href="settings">@L["page.settings"]</MudMenuItem>
                    <MudMenuItem Href="rules">@L["page.rules"]</MudMenuItem>
                    <MudMenuItem Href="appearance">@L["page.appearance"]</MudMenuItem>
                    <MudMenuItem OnClick="() => Ui.SetDarkMode(!Ui.DarkMode)">@(Ui.DarkMode ? L["menu.lightMode"] : L["menu.darkMode"])</MudMenuItem>
                    <MudMenuItem Href="transactions">@L["page.transactions"]</MudMenuItem>
                    <MudMenuItem Href="recurring">@L["page.recurring"]</MudMenuItem>
                    <MudMenuItem Href="notifications">@L["page.notifications"]</MudMenuItem>
                    <MudDivider />
                    <MudMenuItem OnClick="LogOutAsync">@L["menu.logout"]</MudMenuItem>
                </ChildContent>
            </MudMenu>
        </header>

        <main class="content">
            @Body
        </main>
    </div>
</div>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // Official KBC Brussels colors (taken from the kbcbrussels.be logo): blue #0097DB, navy #0D2A50.
    // Primary follows the accent from Appearance > Themes (KBC blue when not personalized).
    private MudTheme _theme = BuildTheme(AppearanceCatalog.DefaultAccent);
    private string _themeAccent = AppearanceCatalog.DefaultAccent;

    private MudTheme Theme
    {
        get
        {
            if (_themeAccent != Ui.Accent)
            {
                _themeAccent = Ui.Accent;
                _theme = BuildTheme(Ui.Accent);
            }
            return _theme;
        }
    }

    private static MudTheme BuildTheme(string accent) => new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = accent,
            Secondary = "#0D2A50",
            AppbarBackground = "#FFFFFF",
            Background = "#FFFFFF",
            Surface = "#FFFFFF",
            TextPrimary = "#1A1A1A",
            TextSecondary = "#5C6B7A",
            LinesDefault = "#E4E8EE",
        },
        // Neutral dark greys (not navy) with light text, so everything stays readable.
        PaletteDark = new PaletteDark
        {
            Primary = accent,
            Secondary = "#E6E6E6",
            AppbarBackground = "#1C1C1E",
            Background = "#1C1C1E",
            Surface = "#2A2A2D",
            DrawerBackground = "#1C1C1E",
            TextPrimary = "#F2F2F2",
            TextSecondary = "#B4B4BA",
            ActionDefault = "#D0D0D5",
            LinesDefault = "#3A3A3E",
            TableLines = "#3A3A3E",
            Divider = "#3A3A3E",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = ["Poppins", "Helvetica", "Arial", "sans-serif"] },
            Button = new ButtonTypography { TextTransform = "none", FontWeight = "600" },
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "8px" },
    };

    private string ShellClass =>
        "shell" + (Ui.DarkMode ? " shell--dark" : "") + (Ui.ActiveTheme is not null ? " shell--themed" : "");

    private async Task GoBackAsync() => await JS.InvokeVoidAsync("history.back");

    private Lang _htmlLang = Lang.En;

    protected override void OnInitialized() => Ui.Changed += OnUiChanged;

    private void OnUiChanged() => InvokeAsync(StateHasChanged);

    // Keep <html lang> in sync with the chosen language (screen readers, spellcheck, hyphenation).
    // On first render, restore the signed-in user from this tab's session, or send them to the login page.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !Ui.SignedIn && !await TryRestoreSessionAsync())
        {
            var here = "/" + Nav.ToBaseRelativePath(Nav.Uri);
            Nav.NavigateTo(here == "/" ? "login" : $"login?returnUrl={Uri.EscapeDataString(here)}");
            return;
        }

        if (_htmlLang == Ui.Language && !firstRender) return;
        _htmlLang = Ui.Language;
        await JS.InvokeVoidAsync("kbcSetLang", Loc.Code(Ui.Language));
    }

    private async Task<bool> TryRestoreSessionAsync()
    {
        try
        {
            var stored = await Session.GetAsync<string>(Pages.Login.SessionKey);
            var account = stored.Success && stored.Value is not null ? Accounts.Find(stored.Value) : null;
            if (account is null) return false;
            Ui.SignIn(account);
            return true;
        }
        catch (System.Security.Cryptography.CryptographicException)
        {
            return false; // session written with an old key (e.g. after a restart): just log in again
        }
    }

    private async Task LogOutAsync()
    {
        await Session.DeleteAsync(Pages.Login.SessionKey);
        Ui.SignOut();
        Nav.NavigateTo("login");
    }

    public void Dispose() => Ui.Changed -= OnUiChanged;
}
