@page "/login"
@layout AuthLayout
@inject UiState Ui
@inject Loc L
@inject AccountStore Accounts
@inject IApiClient Api
@inject NavigationManager Nav
@inject ProtectedSessionStorage Session
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject IWebHostEnvironment Environment

<PageTitle>@L.PageTitle(_signup ? "auth.signup" : "auth.login")</PageTitle>

<div class="auth-lang" role="radiogroup" aria-label="Language">
    @foreach (var (lang, label) in Languages)
    {
        <button type="button" role="radio" lang="@Loc.Code(lang)" aria-checked="@(Ui.Language == lang ? "true" : "false")"
                class="auth-lang-option @(Ui.Language == lang ? "is-selected" : "")" @onclick="() => SetLanguageAsync(lang)">@label</button>
    }
</div>

<main class="auth-card">
    <div class="auth-logo"><KbcLogo /></div>

    <h1 class="visually-hidden">@L[_signup ? "auth.signup" : "auth.login"]</h1>

    <form class="auth-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault novalidate>
        @if (_signup)
        {
            <label for="auth-name">@L["auth.name"]</label>
            <input id="auth-name" class="auth-input" autocomplete="name" @bind="_name" @bind:event="oninput" />
        }

        <label for="auth-email">@L["auth.email"]</label>
        <input id="auth-email" class="auth-input" type="email" autocomplete="email" @bind="_email" @bind:event="oninput" />

        <label for="auth-password">@L["auth.password"]</label>
        <input id="auth-password" class="auth-input" type="password" autocomplete="@(_signup ? "new-password" : "current-password")"
               @bind="_password" @bind:event="oninput" />

        @if (_signup)
        {
            <label for="auth-confirm">@L["auth.confirm"]</label>
            <input id="auth-confirm" class="auth-input" type="password" autocomplete="new-password" @bind="_confirm" @bind:event="oninput" />
        }

        @if (_error is not null)
        {
            <p class="auth-error" role="alert">@_error</p>
        }

        <button type="submit" class="auth-submit" disabled="@_busy">@L[_signup ? "auth.submitSignup" : "auth.login"]</button>

        <p class="auth-switch">
            @L[_signup ? "auth.haveAccount" : "auth.noAccount"]
            <button type="button" class="auth-link" @onclick="ToggleMode">@L[_signup ? "auth.login" : "auth.signup"]</button>
        </p>

        @if ((Api.IsMock || (Environment.IsDevelopment() && Configuration.GetValue<bool>("SimulatorDemoLoginEnabled"))) && !_signup && Accounts.Demo is not null)
        {
            <button type="button" class="auth-link auth-demo" disabled="@_busy" @onclick="UseDemoAsync">@L["auth.demo"]</button>
        }
    </form>

    <p class="auth-note">@L["auth.note"]</p>
</main>

@code {
    public const string SessionKey = "tectonic-auth";

    private static readonly (Lang Lang, string Label)[] Languages = [(Lang.En, "EN"), (Lang.Fr, "FR"), (Lang.Nl, "NL")];

    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private bool _signup;
    private bool _busy;
    private string _name = "";
    private string _email = "";
    private string _password = "";
    private string _confirm = "";
    private string? _error;

    protected override void OnInitialized()
    {
        if (Ui.SignedIn) Nav.NavigateTo(SafeReturnUrl);
    }

    private async Task SetLanguageAsync(Lang lang)
    {
        Ui.SetLanguage(lang);
        await JS.InvokeVoidAsync("kbcSetLang", Loc.Code(lang));
    }

    private void ToggleMode()
    {
        _signup = !_signup;
        _error = null;
        _password = _confirm = "";
    }

    private async Task UseDemoAsync()
    {
        _email = Accounts.Demo!.Email;
        _password = Accounts.Demo.Password;
        _error = null;
        if (!Api.IsMock) await SubmitAsync();
    }

    private async Task SubmitAsync()
    {
        if (_busy) return;
        _error = Validate();
        if (_error is not null) return;

        _busy = true;
        try
        {
            var session = _signup
                ? await Api.SignupAsync(_name, _email, _password)
                : await Api.LoginAsync(_email, _password);
            await Session.SetAsync(SessionKey, session);
            Ui.SignIn(session);
            _password = _confirm = "";
            Nav.NavigateTo(SafeReturnUrl);
        }
        catch (HttpRequestException ex)
        {
            _error = ex.StatusCode == System.Net.HttpStatusCode.Unauthorized ? L["auth.err.invalid"] : ex.Message;
        }
        finally { _busy = false; }
    }

    private string? Validate()
    {
        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrEmpty(_password) || (_signup && (string.IsNullOrWhiteSpace(_name) || string.IsNullOrEmpty(_confirm))))
            return L["auth.err.required"];
        var email = _email.Trim();
        var at = email.IndexOf('@');
        if (at < 1 || email.LastIndexOf('.') < at + 2 || email.EndsWith('.') || email.Contains(' '))
            return L["auth.err.email"];
        if (_signup && _password.Length < 8) return L["auth.err.short"];
        if (_signup && _password != _confirm) return L["auth.err.match"];
        return null;
    }

    // Only redirect to pages inside this app (prevents open redirects via ?returnUrl=).
    private string SafeReturnUrl =>
        !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") && !ReturnUrl.StartsWith("/\\") && !ReturnUrl.StartsWith("/login")
            ? ReturnUrl.TrimStart('/')
            : "";
}
