@page "/"

<PageTitle>Tectonic</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Know when your expenses change</MudText>
<MudText Class="mb-6">Add mock incomes and expenses. The rules below decide when you get an email.</MudText>

<MudGrid>
    <MudItem xs="12" md="4">
        <MudCard Class="pa-2" Style="height: 100%">
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Error" Size="Size.Large" />
                <MudText Typo="Typo.h6">Price increase</MudText>
                <MudText Typo="Typo.body2">An expense at a company costs more than your previous one there.</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudCard Class="pa-2" Style="height: 100%">
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.EventRepeat" Color="Color.Success" Size="Size.Large" />
                <MudText Typo="Typo.h6">New recurring expense</MudText>
                <MudText Typo="Typo.body2">The same expense happens on the same day two months in a row.</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudCard Class="pa-2" Style="height: 100%">
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Large" />
                <MudText Typo="Typo.h6">Recurring expense stopped</MudText>
                <MudText Typo="Typo.body2">A recurring expense misses its payment the following month.</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

<MudButton Href="transactions" Variant="Variant.Filled" Color="Color.Primary" Class="mt-6"
           StartIcon="@Icons.Material.Filled.Add">Add a transaction</MudButton>
