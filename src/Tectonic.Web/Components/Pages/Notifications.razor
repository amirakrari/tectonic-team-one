@page "/notifications"
@inject IApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Notifications</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Notifications</MudText>
<MudText Typo="Typo.body2" Class="mb-4">Every email the rules have sent.</MudText>

@if (_items is null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (_items.Count == 0)
{
    <MudAlert Severity="Severity.Info">No notifications sent yet.</MudAlert>
}
else
{
    <MudStack Spacing="2">
        @foreach (var n in _items.OrderByDescending(n => n.CreatedAt))
        {
            <MudPaper Class="pa-3 d-flex align-center gap-3">
                <MudIcon Icon="@IconOf(n.Type)" Color="@ColorOf(n.Type)" />
                <div class="flex-grow-1">
                    <MudText>@n.Message</MudText>
                    <MudText Typo="Typo.caption">@n.CreatedAt.ToString("dd/MM/yyyy HH:mm")</MudText>
                </div>
                <MudChip T="string" Size="Size.Small" Color="@ColorOf(n.Type)">@LabelOf(n.Type)</MudChip>
            </MudPaper>
        }
    </MudStack>
}

@code {
    private List<Notification>? _items;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _items = await Api.GetNotificationsAsync();
        }
        catch (Exception ex)
        {
            _items = [];
            Snackbar.Add($"Could not load notifications: {ex.Message}", Severity.Error);
        }
    }

    private static string IconOf(NotificationType type) => type switch
    {
        NotificationType.PriceIncrease => Icons.Material.Filled.TrendingUp,
        NotificationType.RecurringAdded => Icons.Material.Filled.EventRepeat,
        _ => Icons.Material.Filled.EventBusy,
    };

    private static Color ColorOf(NotificationType type) => type switch
    {
        NotificationType.PriceIncrease => Color.Error,
        NotificationType.RecurringAdded => Color.Success,
        _ => Color.Default,
    };

    private static string LabelOf(NotificationType type) => type switch
    {
        NotificationType.PriceIncrease => "Price increase",
        NotificationType.RecurringAdded => "New recurring",
        _ => "Recurring stopped",
    };
}
