@page "/recurring"
@inject IApiClient Api
@inject UiState Ui
@inject Loc L
@inject ISnackbar Snackbar

<PageTitle>@L.PageTitle("page.recurring")</PageTitle>

<SectionContent SectionName="page-title">@L["page.recurring"]</SectionContent>

<h1 class="page-heading page-heading--tight">@L["page.recurring"]</h1>
@if (Api.IsMock)
{
<p class="muted page-intro">
    @((MarkupString)L["rec.intro"])
    @L[Ui.CriticalOnly ? "rec.intro.on" : "rec.intro.off"]
</p>
}

@if (_items is null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (_items.Count == 0)
{
    <MudAlert Severity="Severity.Info">@L["rec.empty"]</MudAlert>
}
else
{
    <MudDataGrid Items="_items" Outlined="true" Elevation="0" Dense="true" Hover="true">
        <Columns>
            <PropertyColumn Property="x => x.Company" Title="@L["tx.company"]" />
            @if (!Api.IsMock)
            {
                <PropertyColumn Property="x => x.Type" Title="@L["tx.type"]">
                    <CellTemplate>@L[$"tx.{context.Item.Type}"]</CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.TransactionKey" Title="@L["tx.streamKey"]" />
                <PropertyColumn Property="x => x.NextExpectedDate" Title="@L["rec.next"]" Format="dd/MM/yyyy" />
            }
            <PropertyColumn Property="x => x.Amount" Title="@L["tx.amount"]">
                <CellTemplate>@L.Money(context.Item.Amount)</CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.DayOfMonth" Title="@L["rec.day"]" />
            <PropertyColumn Property="x => x.AddedAt" Title="@L[Api.IsMock ? "rec.since" : "rec.last"]" Format="dd/MM/yyyy" />
            @if (Api.IsMock)
            {
            <TemplateColumn Title="@L["rec.priority"]" Sortable="false" Filterable="false">
                <CellTemplate>
                    <div class="priority-toggle" role="radiogroup" aria-label="@L.F("rec.priorityOf", context.Item.Company)">
                        <button type="button" role="radio" aria-checked="@(context.Item.IsCritical ? "true" : "false")"
                                class="priority-option @(context.Item.IsCritical ? "is-critical" : "")"
                                @onclick="() => SetCriticalAsync(context.Item, true)">@L["rec.critical"]</button>
                        <button type="button" role="radio" aria-checked="@(context.Item.IsCritical ? "false" : "true")"
                                class="priority-option @(context.Item.IsCritical ? "" : "is-regular")"
                                @onclick="() => SetCriticalAsync(context.Item, false)">@L["rec.regular"]</button>
                    </div>
                </CellTemplate>
            </TemplateColumn>
            }
        </Columns>
    </MudDataGrid>
}

@code {
    private List<RecurringExpense>? _items;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _items = await Api.GetRecurringExpensesAsync();
        }
        catch (Exception ex)
        {
            _items = [];
            Snackbar.Add(L.F("rec.loadError", ex.Message), Severity.Error);
        }
    }

    private async Task SetCriticalAsync(RecurringExpense item, bool critical)
    {
        if (item.IsCritical == critical) return;
        try
        {
            await Api.SetCriticalAsync(item.Id, critical);
            item.IsCritical = critical;
            Snackbar.Add(L.F("rec.marked", item.Company, L[critical ? "rec.critical" : "rec.regular"].ToLowerInvariant()), Severity.Normal, o => o.VisibleStateDuration = 2000);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L.F("rec.updateError", item.Company, ex.Message), Severity.Error);
        }
    }
}
