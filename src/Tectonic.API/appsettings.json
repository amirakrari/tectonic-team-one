{
  "ConnectionStrings": {
    "Application": "Data Source=tectonic.db"
  },
  "Jwt": {
    "Issuer": "expense-watch",
    "Audience": "expense-watch-web"
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "From": "",
    "Recipient": ""
  },
  "Simulator": {
    "Enabled": true,
    "IntervalSeconds": 3,
    "BaseUrl": "http://127.0.0.1:5000",
    "Email": "simulator@example.test",
    "RenewBeforeExpirySeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient.Simulator": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
